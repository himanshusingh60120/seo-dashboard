# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # on Vercel set to https://your-app.vercel.app

# Extra individual Google accounts allowed to sign in (comma-separated), on top of the allowed domains below.
# Note: an empty value no longer allows "any account" — sign-in is limited to the allowed domains + this list.
ALLOWED_EMAILS=you@example.com



# site: search checks (Indexing and Deindexed pages tabs). Set ONE of these.
# SerpApi (recommended): every search is archived with a saved copy of Google's results page,
# which you can show as proof. https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Serper.dev (cheaper, results only, no saved page). https://serper.dev/api-key
SERPER_API_KEY=
# Optional: Google interface language and country for site: searches (e.g. SERP_GL=in for India)
SERP_HL=en
SERP_GL=



# .env.example
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=                      # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000    # on Vercel: https://your-app.vercel.app

# Who can sign in
# Any verified Google account on these domains can sign in (built-in list in lib/access.ts):
#   @kingsresearch.com, @datademand.com, @ondot.com, @kingsglobal.com, @kgv.ae, @kingstechmedia.com
# Leave ALLOWED_DOMAINS unset to use that built-in list. Setting it REPLACES the list (comma-separated, no @ needed).
# Only exact domains match: someone@mail.kingsresearch.com is NOT allowed.
# ALLOWED_DOMAINS=kingsresearch.com,datademand.com,ondot.com,kingsglobal.com,kgv.ae,kingstechmedia.com

# Extra individual accounts allowed to sign in (comma-separated), on top of the domains above. Optional.
ALLOWED_EMAILS=hsingh@kingsresearch.com

# Who can run the AI GSC audit. Defaults to hsingh@kingsresearch.com when unset.
AUDIT_EMAILS=hsingh@kingsresearch.com

# OpenAI: writes the fixes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional, reasoning models only: "low" makes gpt-5 models faster and cheaper
# OPENAI_REASONING_EFFORT=low

# Jev (TypeSafe AI): cheap yes/no checks (cost gate + fact-check of GPT's answer)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Via Vercel AI Gateway instead: JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe, JEV_MODEL=typesafe-ai/jev, JEV_API_KEY=<AI Gateway key>

# Optional
AUDIT_MAX_AI_GROUPS=15
# SITE_CHECK_ALLOWED_HOSTS=hs@kingsresearch.com

# Shared storage for the Crawl activity tab (Vercel → Storage → Upstash Redis adds these automatically).
# Only needed locally if you want crawl data shared while developing: run `vercel env pull .env.local`.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Daily index checks (Google Sheet as the database), run by Vercel cron as the service account
GOOGLE_SERVICE_ACCOUNT_JSON=        # the whole service-account key file (JSON)
INDEX_SHEET_ID=                     # 1J8_e9VtqSgMuZErW2yFWIVxDkkKqtgS4vp2APTcKFSo
CRON_SECRET=                        # any long random string; Vercel sends it with each scheduled run
INDEX_DAILY_BUDGET=1800             # URL Inspections per property per day for the job (Google allows 2,000)

# Optional: signs the Chrome extension keys (defaults to NEXTAUTH_SECRET). Change it to cancel every key at once.
CAPTURE_SECRET=

# Optional: encrypts the Google sign-ins saved for daily checks (defaults to NEXTAUTH_SECRET). Needs Upstash Redis.
TOKEN_SECRET=

# Who runs the weekly Search Console captures (Chrome extension). Defaults to these three when unset.
# CAPTURE_EMAILS=hsingh@kingsresearch.com,asavalekar@kingstechmedia.com,pkadu@ondot.com
