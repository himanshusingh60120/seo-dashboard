# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # on Vercel set to https://your-app.vercel.app

# Comma-separated Google accounts allowed to sign in (leave empty to allow any account)
ALLOWED_EMAILS=you@example.com



# site: search checks (Indexing and Deindexed pages tabs). Set ONE of these.
# SerpApi (recommended): every search is archived with a saved copy of Google's results page,
# which you can show as proof. https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Serper.dev (cheaper, results only, no saved page). https://serper.dev/api-key
SERPER_API_KEY=
# Optional: Google interface language and country for site: searches (e.g. SERP_GL=in for India)
SERP_HL=en
SERP_GL=



# .env.example
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=                      # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000    # on Vercel: https://your-app.vercel.app

# Who can sign in (comma-separated). REQUIRED: empty = nobody can sign in.
ALLOWED_EMAILS=hsingh@kingsresearch.com

# Who can run the AI GSC audit. Defaults to hsingh@kingsresearch.com when unset.
AUDIT_EMAILS=hsingh@kingsresearch.com

# OpenAI: writes the fixes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Jev (TypeSafe AI): cheap yes/no checks (cost gate + fact-check of GPT's answer)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Via Vercel AI Gateway instead: JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe, JEV_MODEL=typesafe-ai/jev, JEV_API_KEY=<AI Gateway key>

# Optional
AUDIT_MAX_AI_GROUPS=15
# SITE_CHECK_ALLOWED_HOSTS=kingsresearch.com
