# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # on Vercel set to https://your-app.vercel.app

# Comma-separated Google accounts allowed to sign in (leave empty to allow any account)
ALLOWED_EMAILS=you@example.com
