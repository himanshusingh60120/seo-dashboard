# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # on Vercel set to https://your-app.vercel.app

# Comma-separated Google accounts allowed to sign in (leave empty to allow any account)
ALLOWED_EMAILS=you@example.com



# site: search checks (Indexing and Deindexed pages tabs). Set ONE of these.
# SerpApi (recommended): every search is archived with a saved copy of Google's results page,
# which you can show as proof. https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Serper.dev (cheaper, results only, no saved page). https://serper.dev/api-key
SERPER_API_KEY=
# Optional: Google interface language and country for site: searches (e.g. SERP_GL=in for India)
SERP_HL=en
SERP_GL=
